{
  "name": "repo-reader",
  "version": "1.0.0-alpha1",
  "description": "Desktop app Electron per navigare repository, leggere documentazione e modificare file testuali",
  "keywords": [
    "electron",
    "markdown",
    "node",
    "documentation",
    "reader",
    "repository",
    "docs"
  ],
  "homepage": "https://github.com/deviloper/repo-reader#readme",
  "bugs": {
    "url": "https://github.com/deviloper/repo-reader/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deviloper/repo-reader.git"
  },
  "license": "ISC",
  "author": "Francesco Colella",
  "type": "commonjs",
  "main": "src/main.js",
  "bin": {
    "repo-reader": "./src/cli.js"
  },
  "files": [
    "forge.config.js",
    "src/**/*",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:win": "electron-forge make --platform win32",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron": "^35.1.4",
    "electron-squirrel-startup": "^1.0.1",
    "monaco-editor": "^0.53.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "electron": "^35.1.4"
  }
}
